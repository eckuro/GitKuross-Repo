# Oslo Insider Alerts Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# DATABASE
# =============================================================================
# SQLite is the default and recommended for most use cases
DATABASE_URL=sqlite+aiosqlite:///oslo_insider_alerts.db

# =============================================================================
# POLLING
# =============================================================================
# How often to check for new transactions in continuous mode (minutes)
POLL_INTERVAL_MINUTES=30

# =============================================================================
# ALERT THRESHOLDS
# =============================================================================
# Minimum single transaction value (NOK) to trigger alert
ALERT_MIN_TRANSACTION_VALUE_NOK=500000

# Minimum percentage of outstanding shares in single transaction
ALERT_MIN_SHARES_PERCENT=0.1

# Aggregate insider transaction value (NOK) within time window
ALERT_AGGREGATE_VALUE_NOK=2000000

# Time window in days for aggregate calculations
ALERT_AGGREGATE_WINDOW_DAYS=7

# Minimum number of insiders trading in same direction for cluster alert
ALERT_MIN_INSIDER_COUNT=2

# =============================================================================
# COMPANY SIZE FILTER
# =============================================================================
# Maximum market cap for small-cap classification (NOK billions)
COMPANY_SMALL_CAP_MAX_NOK_BILLIONS=5.0

# Maximum market cap for medium-cap classification (NOK billions)
COMPANY_MEDIUM_CAP_MAX_NOK_BILLIONS=25.0

# Always include these tickers regardless of market cap (JSON array)
# COMPANY_INCLUDE_TICKERS=["AKER","SCATC"]

# Always exclude these tickers from alerts (JSON array)
# COMPANY_EXCLUDE_TICKERS=["EQNR","DNB"]

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Channels to use for alerts (JSON array)
# Options: "console", "email", "slack"
NOTIFY_CHANNELS=["console"]

# -----------------------------------------------------------------------------
# Slack Configuration (if using slack channel)
# -----------------------------------------------------------------------------
# Slack incoming webhook URL
# NOTIFY_SLACK_WEBHOOK_URL=your-slack-webhook-url-here

# Slack channel name
NOTIFY_SLACK_CHANNEL=#insider-alerts

# -----------------------------------------------------------------------------
# Email Configuration (if using email channel)
# -----------------------------------------------------------------------------
# SMTP server hostname
# NOTIFY_EMAIL_SMTP_HOST=smtp.gmail.com

# SMTP server port
NOTIFY_EMAIL_SMTP_PORT=587

# SMTP username
# NOTIFY_EMAIL_SMTP_USER=your-email@gmail.com

# SMTP password (use app-specific password for Gmail)
# NOTIFY_EMAIL_SMTP_PASSWORD=your-app-password

# From email address
# NOTIFY_EMAIL_FROM=alerts@yourdomain.com

# Recipient email addresses (JSON array)
# NOTIFY_EMAIL_TO=["recipient1@example.com","recipient2@example.com"]

# =============================================================================
# DATA SOURCE
# =============================================================================
# Base URL for Oslo Børs NewsWeb (usually no need to change)
DATA_NEWSWEB_BASE_URL=https://newsweb.oslobors.no

# Delay between API requests in seconds (be nice to the server)
DATA_REQUEST_DELAY_SECONDS=1.0

# Cache TTL for market data in minutes
DATA_CACHE_TTL_MINUTES=15
